    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.6",
    "wait-on": "^7.0.0"
  },
  "dependencies": {
    "@types/electron": "^1.4.38",
    "chokidar": "^4.0.3",
    "glob": "^11.0.3",
